# Copy this file to .env and fill in your values.
# cp .env.example .env

# ========== App database (SQLite) ==========
# For production on Vercel, use Turso or Neon and set DATABASE_URL there.
DATABASE_URL="file:./prisma/dev.db"

# ========== Admin ==========
# Used for /admin login (events, education videos, tributes).
ADMIN_PASSWORD="admin"

# ========== Fundraise Up API ==========
# API key for reading donation data from Fundraise Up (Donations: Read)
# Used by /api/fundraiser to pull campaign totals for the progress bar
DONATION_API_KEY="your-fundraiseup-api-key"

# ========== GoFundMe ==========
# URL slug from the GoFundMe campaign (the part after gofundme.com/f/)
# Used by /api/fundraiser to pull GoFundMe donations and merge with Fundraise Up totals
GOFUNDME_SLUG="support-national-leiomyosarcoma-foundation"

# ========== Resend (email) ==========
# API key from https://resend.com/api-keys
# Used for contact form submissions and fundraiser confirmation emails
RESEND_API_KEY="re_..."

# ========== Stripe (Pillars of Purpose fundraiser + custom merch) ==========
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public site URL used for merch mockup images and Printify print files
NEXT_PUBLIC_SITE_URL="https://nlmsf.org"

# ========== Gemini (optional merch image generation) ==========
# If unset, Merch Studio still generates unique on-brand print graphics.
GEMINI_API_KEY=""

# ========== Printify (print-on-demand fulfillment) ==========
# Personal access token from https://printify.com/
# Accepted names: PRINTIFY_API_TOKEN, printify, or PRINTIFY
# Shop id is optional; we use the NLMSF shop from the token if omitted.
PRINTIFY_API_TOKEN=""
PRINTIFY_SHOP_ID=""
# After products exist in this Printify shop, staff import them at /admin/merch
# ("Import Printify products") so they appear on /gift-shop#custom-merch.
# Optional comma-separated product IDs if the shop list is empty:
# PRINTIFY_SYNC_PRODUCT_IDS=6aaaf7a0d6dccab5fb0d9ccc,6aaaf795b04bce66250449a5
# Optional catalog overrides (defaults are Bella+Canvas tee/long sleeve, Gildan hoodie, Yupoong dad cap via Printify Choice)
# PRINTIFY_BLUEPRINT_SHORT_TEE=12
# PRINTIFY_PROVIDER_SHORT_TEE=99
# PRINTIFY_BLUEPRINT_LONG_TEE=41
# PRINTIFY_PROVIDER_LONG_TEE=99
# PRINTIFY_BLUEPRINT_HOODIE=77
# PRINTIFY_PROVIDER_HOODIE=99
# PRINTIFY_BLUEPRINT_HAT=1447
# PRINTIFY_PROVIDER_HAT=99

# ========== Tribute pages – WordPress DB (optional) ==========
# Same tables as the NLMSF Tribute Pages Manager PHP plugin ({prefix}nlmsf_tributes, {prefix}nlmsf_tribute_donors, {prefix}nlmsf_tribute_comments). Use your wp-config.php table prefix (e.g. qlr_).
# When all of HOST, USER, and NAME are set, tributes are read/written from this MySQL DB:
#   - /tributes-directory/ and /tribute/[slug]/ use WordPress data and images
#   - Comments submitted on tribute pages are stored in WordPress
#   - /admin/tributes (create, edit, delete, donors) writes to WordPress
WORDPRESS_DB_HOST=127.0.0.1
WORDPRESS_DB_USER=u2zy5w9hj9mxq
WORDPRESS_DB_PASSWORD=9ns2364wb93q
WORDPRESS_DB_NAME=dbf55acvpn54re
WORDPRESS_DB_PORT=3306
WORDPRESS_DB_PREFIX=qlr_
